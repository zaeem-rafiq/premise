{
  // The Cloudflare shells and their unit tests. `worker-configuration.d.ts` is generated by `npm run types` and
  // holds the runtime types and the bindings of wrangler.jsonc. A unit test here names the same types as the
  // file it tests (`Env`), so it is compiled by this program.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["worker-configuration.d.ts", "src/worker/**/*.ts"]
}
